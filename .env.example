# =============================================================
# .env.example — NICC-SJ Finance & Membership Portal
#
# Copy this file to `.env.local` and fill in the values supplied
# by the project admin (these are the hosted Supabase **dev**
# project URL and anon key). See docs/technology.md §8.3, §16.
#
# IMPORTANT:
#   - Only `VITE_`-prefixed variables are exposed to the SPA
#     bundle. Never put service-role keys, DB passwords, or any
#     other secrets in this file or in `.env.local`.
#   - `.env.local` is git-ignored (see .gitignore). `.env.example`
#     is the only env file committed to the repo.
#   - The same two variables are configured in GitHub repo
#     Settings → Secrets and variables → Actions, and consumed
#     by .github/workflows/deploy.yml at build time.
# =============================================================

# Public URL of the hosted Supabase project (dev for local work,
# prod in GitHub Actions). Looks like: https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Public anon (publishable) key — safe to ship in the SPA bundle.
# Row Level Security policies are the source of truth for access;
# this key only authenticates the request as "anonymous".
# Find it in Supabase Studio → Project Settings → API → anon public.
VITE_SUPABASE_ANON_KEY=
