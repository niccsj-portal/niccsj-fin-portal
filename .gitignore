# ============================================================
# .gitignore — NICC-SJ Finance & Membership Portal
# Aligned with docs/technology.md (Node 20 LTS + npm, Vite, TS,
# Supabase CLI optional; no Docker required).
# ============================================================

# ----- Secrets & environment -----
# Never commit real secrets. .env.example IS committed (see below).
.env
.env.*
!.env.example

# ----- Node / npm -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp.*
.npm/
.yarn/
.pnpm-store/

# ----- Build output -----
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vercel/
.turbo/

# ----- Vite -----
.vite/
*.local

# ----- TypeScript -----
*.tsbuildinfo
.tsbuildinfo

# ----- Test / coverage -----
coverage/
*.lcov
.nyc_output/
.vitest-cache/
playwright-report/
test-results/

# ----- Supabase (CLI scratch & local stack artifacts) -----
.supabase/
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*

# ----- Logs -----
logs/
*.log

# ----- Editor / IDE -----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.code-workspace

# ----- OS files -----
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Linux
*~

# ----- Misc tooling caches -----
.eslintcache
.stylelintcache
.parcel-cache/
.cache/

# ----- Generated brand assets are committed (see docs/graphics.md §7.2) -----
# (no ignore rule needed; explicit reminder)

# ----- PDFs/CSVs generated during local testing -----
*.generated.pdf
*.generated.csv
